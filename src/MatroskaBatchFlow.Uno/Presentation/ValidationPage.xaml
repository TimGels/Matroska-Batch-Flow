<Page
    x:Class="MatroskaBatchFlow.Uno.Presentation.ValidationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:MatroskaBatchFlow.Uno.Presentation"
    xmlns:models="using:MatroskaBatchFlow.Uno.Models"
    NavigationCacheMode="Required">

    <Page.Resources>
        <CollectionViewSource x:Key="ChecksByCategory" IsSourceGrouped="True"
                              Source="{x:Bind ViewModel.CheckSections, Mode=OneWay}" />
        <DataTemplate x:Key="ChecksHeader" x:DataType="local:ValidationViewModel">
            <StackPanel Spacing="8">
                <TextBlock x:Uid="ChecksPageTitle" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="{x:Bind local:ValidationText.Removed(RemovedFileCount), Mode=OneWay}" TextWrapping="Wrap"
                           Visibility="{x:Bind HasRemovalNotice, Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                <TextBlock Text="{x:Bind local:ValidationText.Summary(FileChecks), Mode=OneWay}" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                <Button HorizontalAlignment="Left" Padding="10,4"
                        Visibility="{x:Bind IsFileScoped, Mode=OneWay}" Command="{x:Bind ShowAllChecksCommand}"
                        AutomationProperties.Name="{x:Bind local:ValidationText.Scope(FocusedFileName), Mode=OneWay}"
                        AutomationProperties.HelpText="{x:Bind local:UiText.Get('ChecksClearFilter')}"
                        ToolTipService.ToolTip="{x:Bind local:UiText.Get('ChecksClearFilter')}">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind local:ValidationText.Scope(FocusedFileName), Mode=OneWay}" TextTrimming="CharacterEllipsis"
                                   ToolTipService.ToolTip="{x:Bind FocusedFile.FilePath, Mode=OneWay}" />
                        <FontIcon Grid.Column="1" Glyph="&#xE711;" FontSize="12" />
                    </Grid>
                </Button>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Narrow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1000" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ChecksList.Visibility" Value="Visible" />
                        <Setter Target="CompactSelectorHost.Visibility" Value="Collapsed" />
                        <Setter Target="FixedHeader.Visibility" Value="Visible" />
                        <Setter Target="InlineHeader.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ContentPresenter x:Name="FixedHeader" Grid.ColumnSpan="2" Margin="0,0,0,24"
                          HorizontalContentAlignment="Stretch" Visibility="Collapsed"
                          Content="{x:Bind ViewModel}" ContentTemplate="{StaticResource ChecksHeader}" />

        <Grid Grid.Row="1" Visibility="{x:Bind ViewModel.FileChecks.HasFindings, Mode=OneWay}">
            <ListView x:Name="ChecksList" Width="320" Margin="0,0,28,0" Visibility="Collapsed"
                      ItemsSource="{Binding Source={StaticResource ChecksByCategory}}"
                      SelectedItem="{x:Bind ViewModel.SelectedCheck, Mode=TwoWay}"
                      SelectionChanged="OnCheckSelectionChanged"
                      SelectionMode="Single"
                      HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="{x:Bind local:UiText.Get('ChecksListName')}">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate x:DataType="models:FileCheckSection">
                                <StackPanel Margin="8,8,0,4" Spacing="4">
                                    <TextBlock Text="{x:Bind local:ValidationText.CategoryHeading(Topic, CategoryCount)}" Visibility="{x:Bind ShowHeading}"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind local:ValidationText.Family(Topic)}" Visibility="{x:Bind ShowFamily}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:FileCheckGroup">
                        <Grid Margin="8,6" ColumnSpacing="8" AutomationProperties.Name="{x:Bind local:ValidationText.Selector(Topic)}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Top" Margin="0,2,0,0">
                                <FontIcon Glyph="&#xE783;" FontSize="16"
                                          Visibility="{x:Bind IsBlocking}"
                                          Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                <FontIcon Glyph="&#xE7BA;" FontSize="16"
                                          Visibility="{x:Bind IsWarning}"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <FontIcon Glyph="&#xE946;" FontSize="16"
                                          Visibility="{x:Bind IsInformation}" />
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{x:Bind local:ValidationText.NavigationLabel(Topic)}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

        </Grid>

        <ScrollViewer x:Name="DetailsScroll" Grid.Row="1" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled" IsTabStop="True"
                      AutomationProperties.Name="{x:Bind local:UiText.Get('ChecksDetailsName')}">
            <StackPanel Spacing="16" Padding="0,0,8,4">
                <ContentPresenter x:Name="InlineHeader" HorizontalContentAlignment="Stretch"
                                  Content="{x:Bind ViewModel}" ContentTemplate="{StaticResource ChecksHeader}" />
                <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Center"
                            Visibility="{x:Bind ViewModel.HasNoFindings, Mode=OneWay}">
                    <TextBlock Text="{x:Bind local:ValidationText.EmptyTitle(ViewModel.FileChecks.FileCount), Mode=OneWay}"
                               Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind local:ValidationText.EmptyDescription(ViewModel.FileChecks.FileCount), Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <!-- Only the Wide visual state sets this host's Visibility. The ComboBox's own binding is re-evaluated
                     whenever the checks change, so it would undo a state setter on the same property. -->
                <Grid x:Name="CompactSelectorHost">
                    <ComboBox x:Name="CompactSelector"
                              x:Uid="ChecksCompactSelector"
                              Visibility="{x:Bind ViewModel.FileChecks.HasFindings, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.VisibleGroups, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedCheck, Mode=TwoWay}"
                              SelectionChanged="OnCheckSelectionChanged"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FileCheckGroup">
                                <TextBlock Text="{x:Bind local:ValidationText.Selector(Topic)}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <StackPanel Spacing="4"
                            Visibility="{x:Bind ViewModel.HasSelectedCheck, Mode=OneWay}">
                    <TextBlock Text="{x:Bind local:ValidationText.Title(ViewModel.SelectedCheck.Topic), Mode=OneWay}"
                               FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind local:ValidationText.Consequence(ViewModel.SelectedCheck.Topic), Mode=OneWay}"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <StackPanel Spacing="12" Visibility="{x:Bind ViewModel.SelectedCheck.HasComparison, Mode=OneWay}">
                    <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsFileScoped, Mode=OneWay}">
                        <TextBlock x:Uid="ChecksThisFile" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind local:ValidationText.Value(ViewModel.FocusedFile.Evidence), Mode=OneWay}"
                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind local:ValidationText.ComparisonHeading(ViewModel.FileChecks), Mode=OneWay}"
                               Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ComparisonRows, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FileCheckValue">
                                <Expander Margin="0,0,4,4" HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Bind local:ValidationText.ValueAndCount(Evidence, Files.Count)}">
                                    <Expander.Header>
                                        <Grid ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind local:ValidationText.Value(Evidence)}" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind local:ValidationText.FileCount(Files.Count)}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Grid>
                                    </Expander.Header>
                                    <ItemsRepeater x:Name="ComparedFiles" x:Load="{x:Bind IsExpanded, Mode=OneWay}"
                                                   ItemsSource="{x:Bind Files}" AutomationProperties.Name="{x:Bind local:ValidationText.ValueAndCount(Evidence, Files.Count)}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="models:FileCheckFile">
                                                <StackPanel Margin="0,4" ToolTipService.ToolTip="{x:Bind FilePath}">
                                                    <TextBlock Text="{x:Bind FileName}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Directory}" TextTrimming="CharacterEllipsis"
                                                               Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <ItemsRepeater Visibility="{x:Bind ViewModel.ShowDiagnostics, Mode=OneWay}"
                               ItemsSource="{x:Bind ViewModel.VisibleFiles, Mode=OneWay}" AutomationProperties.Name="{x:Bind local:UiText.Get('ChecksDiagnosticsName')}">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:FileCheckFile">
                            <StackPanel Margin="0,8" Spacing="4" ToolTipService.ToolTip="{x:Bind FilePath}">
                                <TextBlock Text="{x:Bind FilePath}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind local:ValidationText.Value(Evidence)}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                <controls:WrapPanel Visibility="{x:Bind ViewModel.CanReviewTrackSettings, Mode=OneWay}">
                    <Button x:Uid="ChecksOpenTracks" Command="{x:Bind ViewModel.ReviewTrackSettingsCommand}"
                            ToolTipService.ToolTip="{x:Bind local:UiText.Get('ChecksTrackSettingsHint')}" Margin="0,0,8,0" />
                    <HyperlinkButton x:Uid="ChecksOpenSettings" Command="{x:Bind ViewModel.OpenValidationSettingsCommand}"
                                     Visibility="{x:Bind ViewModel.ShowValidationSettings, Mode=OneWay}" />
                </controls:WrapPanel>
                <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.CanRemoveUnsupported, Mode=OneWay}">
                    <TextBlock x:Uid="ChecksRemovalHint" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Content="{x:Bind local:ValidationText.RemoveAction(ViewModel.RemovalCount), Mode=OneWay}"
                            Command="{x:Bind ViewModel.RemoveUnsupportedCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
