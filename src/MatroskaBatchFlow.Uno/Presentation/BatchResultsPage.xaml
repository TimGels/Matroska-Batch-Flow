<Page
    x:Class="MatroskaBatchFlow.Uno.Presentation.BatchResultsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MatroskaBatchFlow.Uno.Presentation"
    xmlns:Controls="using:MatroskaBatchFlow.Uno.Presentation.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:MatroskaBatchFlow.Uno.Models"
    NavigationCacheMode="Enabled">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="20" Padding="0,0,8,8">
            <TextBlock x:Uid="ResultsPageTitle" FontSize="28" FontWeight="SemiBold" />

            <StackPanel Spacing="4" HorizontalAlignment="Left" MaxWidth="400"
                        Visibility="{x:Bind ViewModel.HasHistoryPicker, Mode=OneWay}">
                <TextBlock Text="{x:Bind local:UiText.Get('ResultsRunPickerName')}" />
                <DropDownButton MinWidth="280" HorizontalContentAlignment="Stretch"
                                AutomationProperties.Name="{x:Bind local:ResultsText.PickerName(ViewModel.SelectedRun), Mode=OneWay}">
                    <TextBlock Text="{x:Bind local:ResultsText.PickerLabel(ViewModel.SelectedRun), Mode=OneWay}"
                               TextTrimming="CharacterEllipsis" />
                    <DropDownButton.Flyout>
                        <Flyout x:Name="RunFlyout" Placement="BottomEdgeAlignedLeft"
                                Opening="OnRunFlyoutOpening" Closing="OnRunFlyoutClosing">
                            <StackPanel MinWidth="280" MaxWidth="400" Spacing="8">
                                <StackPanel x:Name="PickerBrowse" Spacing="8">
                                    <ListView x:Name="RunList" MaxHeight="300" SelectionMode="Single"
                                              SingleSelectionFollowsFocus="False" IsItemClickEnabled="True" ItemClick="OnRunPicked"
                                              SelectionChanged="OnPickerSelectionChanged" ContainerContentChanging="OnPickerContainerChanging"
                                              ItemsSource="{x:Bind ViewModel.Runs, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.SelectedRun, Mode=OneWay}"
                                              Visibility="{x:Bind ViewModel.HasRuns, Mode=OneWay}"
                                              AutomationProperties.Name="{x:Bind local:UiText.Get('ResultsRunPickerName')}">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:BatchRunSummary">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                                                               Text="{x:Bind PickerLabel, Mode=OneWay}" />
                                                    <Button Grid.Column="1" Width="32" Height="32" Padding="0"
                                                            Background="Transparent" BorderThickness="0"
                                                            Tag="{x:Bind}" Click="OnRemoveRunClick"
                                                            ToolTipService.ToolTip="{x:Bind local:UiText.Get('HistoryRemove')}"
                                                            AutomationProperties.Name="{x:Bind local:ResultsText.RemoveRunName(PickerLabel), Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="16" AutomationProperties.AccessibilityView="Raw" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <Button x:Uid="HistoryClear" HorizontalAlignment="Stretch" Click="OnClearHistoryClick"
                                            Visibility="{x:Bind ViewModel.CanClearResultHistory, Mode=OneWay}" />
                                    <InfoBar x:Uid="HistoryRecoveryNotice" IsClosable="False" Severity="Warning"
                                             IsOpen="{x:Bind ViewModel.HasUnreadableHistory, Mode=OneWay}">
                                        <InfoBar.ActionButton>
                                            <Button x:Name="ResetHistoryButton" x:Uid="HistoryResetUnreadable" Click="OnResetHistoryClick" />
                                        </InfoBar.ActionButton>
                                    </InfoBar>
                                </StackPanel>
                                <StackPanel x:Name="PickerConfirmation" Visibility="Collapsed" Spacing="8">
                                    <TextBlock x:Name="ConfirmationQuestion" TextWrapping="Wrap"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <ScrollViewer x:Name="ConfirmationDetails" MaxHeight="144" VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                        <TextBlock x:Name="RemovalDescription" TextWrapping="Wrap" />
                                    </ScrollViewer>
                                    <TextBlock x:Uid="HistoryMediaNote" TextWrapping="Wrap" />
                                    <toolkit:WrapPanel HorizontalSpacing="8" VerticalSpacing="8">
                                        <Button x:Name="CancelRemoval" Content="{x:Bind local:UiText.Get('HistoryCancel')}" Click="OnCancelRemoval" />
                                        <Button x:Name="ConfirmRemoval" Click="OnConfirmHistoryAction" />
                                        <Button x:Name="RestoreMissingButton" x:Uid="HistoryRestoreMissing" Visibility="Collapsed"
                                                Click="OnConfirmHistoryAction" />
                                    </toolkit:WrapPanel>
                                </StackPanel>
                                <InfoBar x:Name="PickerError" Severity="Error" IsClosable="False" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>

            <InfoBar x:Name="HistoryFeedback" Severity="Success" AutomationProperties.LiveSetting="Polite" />

            <InfoBar x:Uid="ResultsUnsavedRuns"
                     IsOpen="{x:Bind ViewModel.HasUnsavedRuns, Mode=OneWay}"
                     Severity="Warning" IsClosable="False" AutomationProperties.LiveSetting="Polite" />

            <!-- No saved batches -->
            <StackPanel Spacing="12" MaxWidth="560" HorizontalAlignment="Center" Margin="0,24,0,0"
                        Visibility="{x:Bind ViewModel.HasNoBatch, Mode=OneWay}">
                <FontIcon Glyph="&#xE9D9;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Uid="ResultsEmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Uid="ResultsEmptyDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Outcome -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasBatch, Mode=OneWay}">
                <InfoBar IsOpen="True" IsClosable="False" AutomationProperties.LiveSetting="Polite"
                         Severity="{x:Bind Severity(ViewModel.Outcome), Mode=OneWay}"
                         Title="{x:Bind local:ResultsText.Headline(ViewModel.Counts), Mode=OneWay}"
                         Message="{x:Bind local:ResultsText.Message(ViewModel.Counts), Mode=OneWay}" />
                <TextBlock Text="{x:Bind local:ResultsText.Timing(ViewModel.StartedAt, ViewModel.Elapsed), Mode=OneWay}"
                           Visibility="{x:Bind ViewModel.HasTiming, Mode=OneWay}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Summary tiles -->
            <toolkit:WrapPanel HorizontalSpacing="8" VerticalSpacing="8" Visibility="{x:Bind ViewModel.HasBatch, Mode=OneWay}">
                <Controls:SummaryTileControl MinWidth="140" Title="{x:Bind local:UiText.Get('ResultsTileFiles')}" Value="{x:Bind ViewModel.Counts.Total, Mode=OneWay}"
                                             Description="{x:Bind local:UiText.Get('ResultsTileFilesDescription')}" />
                <Controls:SummaryTileControl MinWidth="140" Title="{x:Bind local:UiText.Get('ResultsTileUpdated')}" Value="{x:Bind ViewModel.Counts.Updated, Mode=OneWay}"
                                             Description="{x:Bind local:UiText.Get('ResultsTileUpdatedDescription')}" />
                <Controls:SummaryTileControl MinWidth="140" Title="{x:Bind local:UiText.Get('ResultsTileWarnings')}" Value="{x:Bind ViewModel.Counts.Warnings, Mode=OneWay}"
                                             Description="{x:Bind local:UiText.Get('ResultsTileWarningsDescription')}" />
                <Controls:SummaryTileControl MinWidth="140" Title="{x:Bind local:UiText.Get('ResultsTileFailed')}" Value="{x:Bind ViewModel.Counts.Failed, Mode=OneWay}"
                                             Description="{x:Bind local:UiText.Get('ResultsTileFailedDescription')}" />
                <Controls:SummaryTileControl MinWidth="140" Title="{x:Bind local:UiText.Get('ResultsTileUnchanged')}" Value="{x:Bind ViewModel.Counts.Unchanged, Mode=OneWay}"
                                             Description="{x:Bind local:UiText.Get('ResultsTileUnchangedDescription')}" />
                <Controls:SummaryTileControl MinWidth="140" Title="{x:Bind local:UiText.Get('ResultsTileCanceled')}" Value="{x:Bind ViewModel.Counts.Canceled, Mode=OneWay}"
                                             Description="{x:Bind local:UiText.Get('ResultsTileCanceledDescription')}" />
                <Controls:SummaryTileControl MinWidth="140" Title="{x:Bind local:UiText.Get('ResultsTileInterrupted')}" Value="{x:Bind ViewModel.Counts.Interrupted, Mode=OneWay}"
                                             Description="{x:Bind local:UiText.Get('ResultsTileInterruptedDescription')}" />
            </toolkit:WrapPanel>

            <!-- Files -->
            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.HasFiles, Mode=OneWay}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="ResultsFilesHeading" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" MinWidth="200"
                              Visibility="{x:Bind ViewModel.ShowFilter, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.FilterOptions, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}"
                              AutomationProperties.Name="{x:Bind local:UiText.Get('ResultsFilterName')}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:FileResultFilterOption">
                                <TextBlock Text="{x:Bind local:ResultsText.Filter(Filter, Count)}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <ItemsRepeater ItemsSource="{x:Bind ViewModel.VisibleFiles, Mode=OneWay}"
                               AutomationProperties.Name="{x:Bind local:UiText.Get('ResultsListName')}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="models:FileResultItem">
                            <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                      IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Bind local:ResultsText.RowName(FileName, Status)}">
                                <Expander.Header>
                                    <Grid ColumnSpacing="12" Padding="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE73E;" FontSize="16" Visibility="{x:Bind IsUpdated}"
                                                      Foreground="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Visibility="{x:Bind IsUpdatedWithWarnings}"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                            <FontIcon Glyph="&#xE783;" FontSize="16" Visibility="{x:Bind IsFailed}"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                            <FontIcon Glyph="&#xE738;" FontSize="16" Visibility="{x:Bind IsUnchanged}"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <FontIcon Glyph="&#xE711;" FontSize="16" Visibility="{x:Bind IsCanceled}"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <FontIcon Glyph="&#xE7BA;" FontSize="16" Visibility="{x:Bind IsInterrupted}"
                                                      Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" ToolTipService.ToolTip="{x:Bind FilePath}">
                                            <TextBlock Text="{x:Bind FileName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{x:Bind Directory}" TextTrimming="CharacterEllipsis"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                                   Text="{x:Bind local:ResultsText.Status(Status)}" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" MinWidth="64" TextAlignment="Right"
                                                   Text="{x:Bind local:ResultsText.Duration(Duration)}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Spacing="16">
                                    <TextBlock Text="{x:Bind local:ResultsText.Note(Status)}" TextWrapping="Wrap"
                                               Visibility="{x:Bind HasNote}" />

                                    <StackPanel Spacing="4" Visibility="{x:Bind HasErrors}">
                                        <TextBlock x:Uid="ResultsErrorsHeading" Style="{StaticResource BodyStrongTextBlockStyle}"
                                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <ItemsControl ItemsSource="{x:Bind Errors}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="4" Visibility="{x:Bind HasWarnings}">
                                        <TextBlock x:Uid="ResultsWarningsHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <ItemsControl ItemsSource="{x:Bind Warnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{x:Bind}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock x:Uid="ResultsLocationHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind FilePath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>

                                    <StackPanel Spacing="8" Visibility="{x:Bind HasCommand}">
                                        <TextBlock x:Uid="ResultsCommandHeading" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <Border Padding="12,8" CornerRadius="4"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <TextBlock Text="{x:Bind Command}" FontFamily="Consolas, Courier New, monospace"
                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        </Border>
                                        <Button x:Uid="ResultsCopyCommand" Tag="{x:Bind Command}" Click="OnCopyCommandClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
