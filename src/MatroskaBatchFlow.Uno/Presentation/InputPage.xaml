<Page
    x:Class="MatroskaBatchFlow.Uno.Presentation.InputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MatroskaBatchFlow.Uno.Presentation"
    xmlns:controls="using:MatroskaBatchFlow.Uno.Presentation.Controls"
    xmlns:converters="using:MatroskaBatchFlow.Uno.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:utu="using:Uno.Toolkit.UI"
    xmlns:Actions="using:MatroskaBatchFlow.Uno.Behavior"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:skia="http://uno.ui/skia"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    mc:Ignorable="d skia"
    NavigationCacheMode="Required">

    <Page.Resources>
        <converters:GreaterThanZeroConverter x:Key="GreaterThanZeroConverter"/>
        <converters:IntThresholdToVisibilityConverter x:Key="IntThresholdToVisibilityConverter"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- CommandBar with actions for file list view-->
        <StackPanel Grid.Column="1"
                    Grid.Row="0"
                    HorizontalAlignment="Stretch"
                    skia:Background="{ThemeResource ControlStrokeColorDefaultBrush}"
                    win:Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondary}"
                    Margin="0,-16,0,12"
                    CornerRadius="{ThemeResource ControlCornerRadius}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <CommandBar Grid.Column="0"
                            DefaultLabelPosition="Right"
                            HorizontalAlignment="Left"
                            Width="Auto">
                    <CommandBar.PrimaryCommands>
                        <AppBarButton Icon="Add"
                                      Command="{x:Bind ViewModel.AddFilesCommand}"
                                      Label="Add Files" />
                        <AppBarSeparator />
                        <AppBarButton Icon="SelectAll"
                                      Label="Select All"
                                      IsEnabled="{x:Bind ViewModel.CanSelectAll, Mode=OneWay}"
                                      Command="{x:Bind ViewModel.SelectAll}"
                                      LabelPosition="Collapsed" />
                        <AppBarButton Icon="ClearSelection"
                                      Label="Undo Selection"
                                      IsEnabled="{x:Bind ViewModel.SelectedFiles.Count, Mode=OneWay, Converter={StaticResource GreaterThanZeroConverter}}"
                                      Command="{x:Bind ViewModel.ClearSelection}"
                                      LabelPosition="Collapsed" />
                    </CommandBar.PrimaryCommands>
                </CommandBar>

                <Grid Grid.Column="1" ColumnSpacing="8" Margin="16,0"
                      Visibility="{x:Bind ViewModel.FileChecks.IsVisible, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind local:ValidationText.InputHeadline(ViewModel.FileChecks, ViewModel.OverlayState.IsActive), Mode=OneWay}"
                               ToolTipService.ToolTip="{x:Bind local:ValidationText.InputHeadline(ViewModel.FileChecks, ViewModel.OverlayState.IsActive), Mode=OneWay}"
                               VerticalAlignment="Center"
                               FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               AutomationProperties.LiveSetting="Polite" />
                    <HyperlinkButton Grid.Column="1"
                                     Content="{x:Bind local:ValidationText.ReviewCount(ViewModel.FileChecks.Groups.Count), Mode=OneWay}"
                                     Command="{x:Bind ViewModel.ReviewFileChecksCommand}"
                                     Visibility="{x:Bind ViewModel.FileChecks.HasFindings, Mode=OneWay}"
                                     VerticalAlignment="Center" />
                </Grid>

                <!-- Right CommandBar-->
                <CommandBar Grid.Column="2"
                            DefaultLabelPosition="Right"
                            HorizontalAlignment="Right">
                    <CommandBar.PrimaryCommands>
                        <AppBarButton Icon="Remove"
                                      Label="Remove"
                                      IsEnabled="{x:Bind ViewModel.SelectedFiles.Count, Mode=OneWay, Converter={StaticResource GreaterThanZeroConverter}}"
                                      Command="{x:Bind ViewModel.RemoveSelected}" />
                        <AppBarSeparator />
                        <AppBarButton Label="Clear"
                                      IsEnabled="{x:Bind ViewModel.FileList.Count, Mode=OneWay, Converter={StaticResource GreaterThanZeroConverter}}"
                                      Command="{x:Bind ViewModel.RemoveAll}">
                            <FontIcon Glyph="&#xEA99;" />
                        </AppBarButton>
                    </CommandBar.PrimaryCommands>
                </CommandBar>
            </Grid>
        </StackPanel>

        <Grid Grid.Column="1" Grid.Row="1"
              skia:Background="{ThemeResource ControlStrokeColorDefaultBrush}"
              win:Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondary}"
              CornerRadius="{ThemeResource ControlCornerRadius}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="16,8" ColumnSpacing="16"
                  Visibility="{x:Bind ViewModel.FileChecks.HasFindings, Mode=OneWay}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Uid="ChecksFileColumn" Style="{ThemeResource CaptionTextBlockStyle}" />
                <TextBlock Grid.Column="1" x:Uid="ChecksCountColumn" HorizontalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" />
            </Grid>
            <ListView x:Name="FileDropListView"
                      Grid.Row="1"
                      Actions:DropFilesBehavior.IsEnabled="True"
                      Actions:DropFilesBehavior.FileDropTarget="{x:Bind ViewModel}"
                      ItemsSource="{x:Bind ViewModel.FileList}"
                      AllowDrop="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      HorizontalContentAlignment="Stretch"
                      SelectionMode="Extended"
                      Actions:ListViewSelectedItemsBehavior.BoundSelectedItems="{x:Bind ViewModel.SelectedFiles, Mode=TwoWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:ScannedFileViewModel">
                        <Grid Margin="0,8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Delete"
                                                    Tag="{x:Bind}"
                                                    Click="OnRemoveFileClicked" />
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <StackPanel Spacing="3" ToolTipService.ToolTip="{x:Bind FileInfo.Path}">
                                <TextBlock Text="{x:Bind FileName}" TextWrapping="Wrap" />
                                <TextBlock x:Uid="ChecksUnsupportedBadge" FontSize="12"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           Visibility="{x:Bind IsUnsupported, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Directory}"
                                           FontSize="12" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <Grid Grid.Column="1" Width="96"
                                  Visibility="{x:Bind HasFileChecks, Mode=OneWay}">
                                <HyperlinkButton Padding="12,4" MinWidth="44" HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" FontSize="12"
                                                 Content="{x:Bind FileCheckCount, Mode=OneWay}"
                                                 Click="OnReviewFileChecksClicked"
                                                 AutomationProperties.Name="{x:Bind local:ValidationText.ReviewFile(FileCheckCount, FileName), Mode=OneWay}"
                                                 ToolTipService.ToolTip="{x:Bind local:ValidationText.TopicList(CheckTopics), Mode=OneWay}" />
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="1" IsHitTestVisible="False"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.2"
                        Visibility="{x:Bind ViewModel.FileList.Count, Mode=OneWay, Converter={StaticResource IntThresholdToVisibilityConverter}, ConverterParameter='1;Collapsed;Visible'}">
                <TextBlock Text="Drag &amp; Drop here"
                           Style="{StaticResource TitleTextBlockStyle}" />
            </StackPanel>

            <controls:OperationOverlay Grid.RowSpan="2" IsActive="{x:Bind ViewModel.OverlayState.IsActive, Mode=OneWay}"
                                            Message="{x:Bind ViewModel.OverlayState.Message, Mode=OneWay}"
                                            IsIndeterminate="{x:Bind ViewModel.OverlayState.IsIndeterminate, Mode=OneWay}"
                                            Current="{x:Bind ViewModel.OverlayState.Current, Mode=OneWay}"
                                            Total="{x:Bind ViewModel.OverlayState.Total, Mode=OneWay}"
                                            ProgressPercent="{x:Bind ViewModel.OverlayState.ProgressPercent, Mode=OneWay}"
                                            BlocksInput="{x:Bind ViewModel.OverlayState.BlocksInput, Mode=OneWay}" />
        </Grid>
    </Grid>
</Page>
