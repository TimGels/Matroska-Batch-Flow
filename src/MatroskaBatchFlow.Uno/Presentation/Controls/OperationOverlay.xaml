<UserControl x:Class="MatroskaBatchFlow.Uno.Presentation.Controls.OperationOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:MatroskaBatchFlow.Uno.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <converters:IntThresholdToVisibilityConverter x:Key="IntThresholdToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Visibility="{x:Bind IsActive, Mode=OneWay}"
          IsHitTestVisible="{x:Bind BlocksInput, Mode=OneWay}">
        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" />

        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="360"
                Width="420"
                MaxWidth="420"
                MinHeight="132"
                Padding="16"
                CornerRadius="{ThemeResource ControlCornerRadius}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Opacity="1">
            <StackPanel Spacing="12">
                <TextBlock Text="{x:Bind Message, Mode=OneWay}"
                           TextWrapping="WrapWholeWords" />

                <TextBlock x:Name="DetailText"
                           Text="{x:Bind Detail, Mode=OneWay}"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1" />

                <ProgressBar IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                             Maximum="100"
                             Value="{x:Bind ProgressPercent, Mode=OneWay}" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Spacing="4"
                                Visibility="{x:Bind Total, Mode=OneWay, Converter={StaticResource IntThresholdToVisibilityConverter}, ConverterParameter='1;Visible;Collapsed'}">
                        <TextBlock Text="{x:Bind Current, Mode=OneWay}" />
                        <TextBlock Text="/" />
                        <TextBlock Text="{x:Bind Total, Mode=OneWay}" />
                    </StackPanel>

                    <Button x:Name="CancelButton"
                            Grid.Column="1"
                            Content="Cancel"
                            AutomationProperties.Name="Cancel operation"
                            Command="{x:Bind CancelCommand, Mode=OneWay}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
