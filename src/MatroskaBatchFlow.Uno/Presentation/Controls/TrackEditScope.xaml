<UserControl x:Class="MatroskaBatchFlow.Uno.Presentation.Controls.TrackEditScope"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MatroskaBatchFlow.Uno.Presentation">
    <StackPanel>
        <TextBlock Text="{x:Bind local:ValidationText.Coverage(ViewModel.EditScope), Mode=OneWay}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Visibility="{x:Bind ViewModel.IsTrackSelected, Mode=OneWay}"
                   AutomationProperties.LiveSetting="Polite" />
        <HyperlinkButton Content="{x:Bind local:ValidationText.ReturnAction(ViewModel.Inspection), Mode=OneWay}" HorizontalAlignment="Left"
                         Visibility="{x:Bind ViewModel.CanReturnToCheck, Mode=OneWay}"
                         Padding="0,4" Click="ReturnToCheck_Click" />
    </StackPanel>
</UserControl>
