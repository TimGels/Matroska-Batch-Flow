<Page
    x:Class="MatroskaBatchFlow.Uno.Presentation.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MatroskaBatchFlow.Uno.Presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:utu="using:Uno.Toolkit.UI"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:Converters="using:MatroskaBatchFlow.Uno.Converters"
    xmlns:helpers="using:MatroskaBatchFlow.Uno.Helpers"
    xmlns:ui="using:CommunityToolkit.WinUI"
    mc:Ignorable="d">

    <Page.Resources>
        <Converters:BoolToIndexConverter x:Key="BoolToIndexConverter"/>

        <!--  Style (inc. the correct spacing) of a section header  -->
        <Style x:Key="SettingsSectionHeaderTextBlockStyle"
               BasedOn="{StaticResource BodyStrongTextBlockStyle}"
               TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollView>
        <Grid>
            <StackPanel HorizontalAlignment="Stretch"
                Spacing="4">
                <TextBlock x:Uid="SettingsPageTitle"
                           FontSize="28" />

                <!--Mkvpropedit section-->
                <TextBlock x:Uid="SettingsMkvpropeditSection"
                   Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SwitchPresenter TargetType="x:Boolean"
                                  Value="{x:Bind ViewModel.IsCustomMkvPropeditPathEnabled, Mode=OneWay}">

                    <controls:Case Value="False">
                        <controls:SettingsCard x:Uid="SettingsExecutableSelection"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE756;}">

                            <ComboBox SelectedIndex="{x:Bind ViewModel.IsCustomMkvPropeditPathEnabled, Mode=TwoWay, Converter={StaticResource BoolToIndexConverter}}">
                                <ComboBoxItem x:Uid="SettingsExecutableIncluded" />
                                <ComboBoxItem x:Uid="SettingsExecutableCustom" />
                            </ComboBox>

                        </controls:SettingsCard>
                    </controls:Case>

                    <controls:Case Value="True">
                        <controls:SettingsExpander x:Uid="SettingsExecutableSelection"
                                           HeaderIcon="{ui:FontIcon Glyph=&#xE756;}"
                                           IsExpanded="True">

                            <ComboBox SelectedIndex="{x:Bind ViewModel.IsCustomMkvPropeditPathEnabled, Mode=TwoWay, Converter={StaticResource BoolToIndexConverter}}">
                                <ComboBoxItem x:Uid="SettingsExecutableIncluded" />
                                <ComboBoxItem x:Uid="SettingsExecutableCustom" />
                            </ComboBox>

                            <controls:SettingsExpander.Items>
                                <controls:SettingsCard x:Uid="SettingsExecutableLocation"
                                               IsEnabled="{x:Bind ViewModel.IsCustomMkvPropeditPathEnabled, Mode=OneWay}">
                                    <controls:SettingsCard.Description>
                                        <TextBlock Text="{x:Bind ViewModel.CustomMkvPropeditPath, Mode=OneWay}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                                    </controls:SettingsCard.Description>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Button Grid.Column="1"
                                        Click="BrowseExecutable_Click"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right">
                                            <Button.Content>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock x:Uid="SettingsExecutableBrowse" />
                                                </StackPanel>
                                            </Button.Content>
                                        </Button>
                                    </Grid>
                                </controls:SettingsCard>
                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                    </controls:Case>
                </controls:SwitchPresenter>

                <!--Batch Validation section-->
                <TextBlock x:Name="ValidationHeader" x:Uid="ChecksSettingsSection"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SwitchPresenter TargetType="x:Boolean"
                                          Value="{x:Bind ViewModel.IsCustomMode, Mode=OneWay}">

                    <controls:Case Value="False">
                        <controls:SettingsCard x:Uid="SettingsStrictnessMode"
                                               HeaderIcon="{ui:FontIcon Glyph=&#xE8FD;}">

                            <ComboBox x:Uid="SettingsStrictnessSelector"
                                      SelectedIndex="{x:Bind ViewModel.SelectedStrictnessModeIndex, Mode=TwoWay}"
                                      MinWidth="120">
                                <ComboBoxItem x:Uid="SettingsStrictnessStrict" />
                                <ComboBoxItem x:Uid="SettingsStrictnessLenient" />
                                <ComboBoxItem x:Uid="SettingsStrictnessCustom" />
                            </ComboBox>
                        </controls:SettingsCard>
                    </controls:Case>

                    <controls:Case Value="True">
                        <controls:SettingsExpander x:Uid="SettingsStrictnessMode"
                                                   HeaderIcon="{ui:FontIcon Glyph=&#xE8FD;}"
                                                   IsExpanded="True">

                            <ComboBox x:Uid="SettingsStrictnessSelector"
                                      SelectedIndex="{x:Bind ViewModel.SelectedStrictnessModeIndex, Mode=TwoWay}"
                                      MinWidth="120">
                                <ComboBoxItem x:Uid="SettingsStrictnessStrict" />
                                <ComboBoxItem x:Uid="SettingsStrictnessLenient" />
                                <ComboBoxItem x:Uid="SettingsStrictnessCustom" />
                            </ComboBox>

                            <controls:SettingsExpander.Items>

                                <!-- Structural Validation -->
                                <controls:SettingsCard x:Uid="SettingsStructuralValidation">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="SettingsTrackCountParity"
                                           VerticalAlignment="Center" />
                                <ComboBox x:Uid="SettingsTrackCountParitySelector"
                                              Grid.Column="1"
                                              SelectedIndex="{x:Bind ViewModel.TrackCountParitySeverityIndex, Mode=TwoWay}"
                                              MinWidth="120"
                                              HorizontalAlignment="Right">
                                    <ComboBoxItem x:Uid="SettingsSeverityOff" />
                                    <ComboBoxItem x:Uid="SettingsSeverityInfo" />
                                    <ComboBoxItem x:Uid="SettingsSeverityWarning" />
                                    <ComboBoxItem x:Uid="SettingsSeverityError" />
                                </ComboBox>
                            </Grid>
                                </controls:SettingsCard>

                                <!-- Audio Track Properties -->
                                <controls:SettingsCard x:Uid="SettingsAudioTrackValidation">
                            <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="SettingsLanguageConsistency" VerticalAlignment="Center" />
                                    <ComboBox x:Uid="SettingsAudioLanguageSelector"
                                                  Grid.Column="1"
                                                  SelectedIndex="{x:Bind ViewModel.AudioLanguageSeverityIndex, Mode=TwoWay}"
                                                  MinWidth="120"
                                                  HorizontalAlignment="Right">
                                        <ComboBoxItem x:Uid="SettingsSeverityOff" />
                                        <ComboBoxItem x:Uid="SettingsSeverityInfo" />
                                        <ComboBoxItem x:Uid="SettingsSeverityWarning" />
                                        <ComboBoxItem x:Uid="SettingsSeverityError" />
                                    </ComboBox>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="SettingsDefaultFlag" VerticalAlignment="Center" />
                                    <ComboBox x:Uid="SettingsAudioDefaultFlagSelector"
                                                  Grid.Column="1"
                                                  SelectedIndex="{x:Bind ViewModel.AudioDefaultFlagSeverityIndex, Mode=TwoWay}"
                                                  MinWidth="120"
                                                  HorizontalAlignment="Right">
                                        <ComboBoxItem x:Uid="SettingsSeverityOff" />
                                        <ComboBoxItem x:Uid="SettingsSeverityInfo" />
                                        <ComboBoxItem x:Uid="SettingsSeverityWarning" />
                                        <ComboBoxItem x:Uid="SettingsSeverityError" />
                                    </ComboBox>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="SettingsForcedFlag" VerticalAlignment="Center" />
                                    <ComboBox x:Uid="SettingsAudioForcedFlagSelector"
                                                  Grid.Column="1"
                                                  SelectedIndex="{x:Bind ViewModel.AudioForcedFlagSeverityIndex, Mode=TwoWay}"
                                                  MinWidth="120"
                                                  HorizontalAlignment="Right">
                                        <ComboBoxItem x:Uid="SettingsSeverityOff" />
                                        <ComboBoxItem x:Uid="SettingsSeverityInfo" />
                                        <ComboBoxItem x:Uid="SettingsSeverityWarning" />
                                        <ComboBoxItem x:Uid="SettingsSeverityError" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                                </controls:SettingsCard>

                                <!-- Video Track Properties -->
                                <controls:SettingsCard x:Uid="SettingsVideoTrackValidation">
                                    <StackPanel Spacing="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="SettingsLanguageConsistency" VerticalAlignment="Center" />
                                    <ComboBox x:Uid="SettingsVideoLanguageSelector"
                                                  Grid.Column="1"
                                                  SelectedIndex="{x:Bind ViewModel.VideoLanguageSeverityIndex, Mode=TwoWay}"
                                                  MinWidth="120"
                                                  HorizontalAlignment="Right">
                                        <ComboBoxItem x:Uid="SettingsSeverityOff" />
                                        <ComboBoxItem x:Uid="SettingsSeverityInfo" />
                                        <ComboBoxItem x:Uid="SettingsSeverityWarning" />
                                        <ComboBoxItem x:Uid="SettingsSeverityError" />
                                    </ComboBox>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="SettingsDefaultFlag" VerticalAlignment="Center" />
                                    <ComboBox x:Uid="SettingsVideoDefaultFlagSelector"
                                                  Grid.Column="1"
                                                  SelectedIndex="{x:Bind ViewModel.VideoDefaultFlagSeverityIndex, Mode=TwoWay}"
                                                  MinWidth="120"
                                                  HorizontalAlignment="Right">
                                        <ComboBoxItem x:Uid="SettingsSeverityOff" />
                                        <ComboBoxItem x:Uid="SettingsSeverityInfo" />
                                        <ComboBoxItem x:Uid="SettingsSeverityWarning" />
                                        <ComboBoxItem x:Uid="SettingsSeverityError" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                                </controls:SettingsCard>

                                <!-- Subtitle Track Properties -->
                                <controls:SettingsCard x:Uid="SettingsSubtitleTrackValidation">
                                    <StackPanel Spacing="8">
                                        <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="SettingsLanguageConsistency" VerticalAlignment="Center" />
                                    <ComboBox x:Uid="SettingsSubtitleLanguageSelector"
                                                  Grid.Column="1"
                                                  SelectedIndex="{x:Bind ViewModel.SubtitleLanguageSeverityIndex, Mode=TwoWay}"
                                                  MinWidth="120"
                                                  HorizontalAlignment="Right">
                                        <ComboBoxItem x:Uid="SettingsSeverityOff" />
                                        <ComboBoxItem x:Uid="SettingsSeverityInfo" />
                                        <ComboBoxItem x:Uid="SettingsSeverityWarning" />
                                        <ComboBoxItem x:Uid="SettingsSeverityError" />
                                    </ComboBox>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="200" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Uid="SettingsForcedFlag" VerticalAlignment="Center" />
                                    <ComboBox x:Uid="SettingsSubtitleForcedFlagSelector"
                                                  Grid.Column="1"
                                                  SelectedIndex="{x:Bind ViewModel.SubtitleForcedFlagSeverityIndex, Mode=TwoWay}"
                                                  MinWidth="120"
                                                  HorizontalAlignment="Right">
                                        <ComboBoxItem x:Uid="SettingsSeverityOff" />
                                        <ComboBoxItem x:Uid="SettingsSeverityInfo" />
                                        <ComboBoxItem x:Uid="SettingsSeverityWarning" />
                                        <ComboBoxItem x:Uid="SettingsSeverityError" />
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                                </controls:SettingsCard>

                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>
                    </controls:Case>
                </controls:SwitchPresenter>
                <!--User Interface section-->
                <TextBlock x:Uid="SettingsUserInterfaceSection"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Uid="SettingsAppTheme"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE771;}">
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"
                              MinWidth="150">
                        <ComboBoxItem x:Uid="SettingsThemeSystem" />
                        <ComboBoxItem x:Uid="SettingsThemeLight" />
                        <ComboBoxItem x:Uid="SettingsThemeDark" />
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="SettingsTrackAvailability"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE7EE;}">
                    <ToggleSwitch x:Uid="SettingsTrackAvailabilityToggle"
                                  IsOn="{x:Bind ViewModel.ShowTrackAvailabilityText, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="SettingsShowArguments"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE8BC;}">
                    <ToggleSwitch x:Uid="SettingsShowArgumentsToggle"
                                  IsOn="{x:Bind ViewModel.ShowMkvpropeditArguments, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="BatchHistoryLimitCard"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE81C;}">
                    <NumberBox x:Uid="BatchHistoryLimitBox"
                               IsEnabled="{x:Bind ViewModel.CanEditBatchHistoryLimit, Mode=OneWay}"
                               Value="{x:Bind ViewModel.BatchHistoryMaxRuns, Mode=TwoWay}"
                               Minimum="{x:Bind ViewModel.BatchHistoryMinRuns}"
                               Maximum="{x:Bind ViewModel.BatchHistoryMaxRunsLimit}"
                               SmallChange="1"
                               LargeChange="10"
                               SpinButtonPlacementMode="Compact"
                               MinWidth="150" />
                </controls:SettingsCard>

                <InfoBar IsOpen="{x:Bind ViewModel.IsBatchHistoryLimitPending, Mode=OneWay}"
                         Visibility="{x:Bind ViewModel.IsBatchHistoryLimitPending, Mode=OneWay}"
                         Severity="Warning"
                         IsClosable="False"
                         Message="{x:Bind BatchHistoryRemovalText(ViewModel.BatchHistoryRunsToRemove, ViewModel.BatchHistoryMaxRuns), Mode=OneWay}"
                         AutomationProperties.LiveSetting="Polite">
                    <InfoBar.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,12">
                            <Button x:Uid="BatchHistoryLimitConfirm"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.ConfirmBatchHistoryLimitCommand}" />
                            <Button x:Uid="BatchHistoryLimitCancel"
                                    Command="{x:Bind ViewModel.CancelBatchHistoryLimitCommand}" />
                        </StackPanel>
                    </InfoBar.Content>
                </InfoBar>

                <InfoBar x:Uid="BatchHistoryLimitRecoveryRequired"
                         IsOpen="{x:Bind ViewModel.IsHistoryRecoveryRequired, Mode=OneWay}"
                         Severity="Warning" IsClosable="False" AutomationProperties.LiveSetting="Polite" />

                <InfoBar x:Uid="BatchHistoryLimitSaveFailed"
                         IsOpen="{x:Bind ViewModel.BatchHistoryLimitSaveFailed, Mode=OneWay}"
                         Severity="Error" IsClosable="False" AutomationProperties.LiveSetting="Polite" />

                <!--Logging section-->
                <TextBlock x:Uid="SettingsLoggingSection"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Uid="SettingsShowLogViewer"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE736;}">
                    <ToggleSwitch x:Uid="SettingsShowLogViewerToggle"
                                  IsOn="{x:Bind ViewModel.EnableLoggingView, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Uid="SettingsLogLevel"
                                       HeaderIcon="{ui:FontIcon Glyph=&#xE7BA;}"
                                       Description="{x:Bind LogLevelDescription}">
                    <ComboBox SelectedIndex="{x:Bind ViewModel.SelectedLogLevelIndex, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.IsLogLevelControlEnabled, Mode=OneWay}"
                              MinWidth="150">
                        <ComboBoxItem x:Uid="SettingsLogLevelVerbose" />
                        <ComboBoxItem x:Uid="SettingsLogLevelDebug" />
                        <ComboBoxItem x:Uid="SettingsLogLevelInformation" />
                        <ComboBoxItem x:Uid="SettingsLogLevelWarning" />
                        <ComboBoxItem x:Uid="SettingsLogLevelError" />
                        <ComboBoxItem x:Uid="SettingsLogLevelFatal" />
                    </ComboBox>
                </controls:SettingsCard>

                <!--Support section-->
                <TextBlock x:Uid="SupportSection"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <controls:SettingsCard x:Uid="SupportCard"
                                       helpers:SupportHeart.Icon="{x:Bind SupportCardIcon}"
                                       ActionIcon="{ui:FontIcon Glyph=&#xE8A7;}"
                                       IsClickEnabled="True"
                                       Command="{x:Bind ViewModel.OpenSupportPageCommand}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon x:Name="SupportCardIcon" Glyph="&#xEB51;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

                <!--About section-->
                <TextBlock x:Uid="SettingsAboutSection"
                           Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"/>

                <controls:SettingsExpander x:Uid="SettingsAboutApp"
                                   Description="{x:Bind CopyrightNotice}"
                                   IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <BitmapIcon ShowAsMonochrome="False"
                            UriSource="ms-appx:///Resources/Assets/PackageLogo.scale-100.png" />
                    </controls:SettingsExpander.HeaderIcon>
                    <TextBlock IsTextSelectionEnabled="True"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="{x:Bind AppVersion}" />
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard HorizontalContentAlignment="Left"
                                       ContentAlignment="Left">
                            <StackPanel Margin="-12,0,0,0"
                                Orientation="Vertical">
                                <HyperlinkButton x:Uid="SettingsLicenseLink"
                                         NavigateUri="https://github.com/TimGels/Matroska-Batch-Flow/blob/main/LICENSE" />
                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="SettingsDependencies"
                                       HorizontalContentAlignment="Left"
                                       ContentAlignment="Vertical">
                            <StackPanel Margin="-12,0,0,0"
                                Orientation="Vertical">
                                <HyperlinkButton x:Uid="SettingsUnoPlatformLink"
                                         NavigateUri="https://github.com/unoplatform/uno" />
                                <HyperlinkButton x:Uid="SettingsDotNetToolkitLink"
                                         NavigateUri="https://github.com/CommunityToolkit/dotnet" />
                                <HyperlinkButton x:Uid="SettingsWindowsAppSdkLink"
                                         NavigateUri="https://github.com/microsoft/windowsappsdk" />
                                <HyperlinkButton x:Uid="SettingsWinUiLink"
                                         NavigateUri="https://github.com/microsoft/microsoft-ui-xaml" />

                            </StackPanel>
                        </controls:SettingsCard>
                        <controls:SettingsCard x:Uid="SettingsUsefulLinks"
                                               HorizontalContentAlignment="Left"
                                               ContentAlignment="Vertical">
                            <StackPanel Margin="-12,0,0,0"
                                Orientation="Vertical">
                                <HyperlinkButton x:Uid="SettingsGitHubLink"
                                         NavigateUri="https://github.com/TimGels/Matroska-Batch-Flow" />
                            </StackPanel>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>
            </StackPanel>
        </Grid>
    </ScrollView>
</Page>
